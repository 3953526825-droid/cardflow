# === 密钥与本地配置：绝对不提交 ===
config/*.config.json
config.json

# === 用户导入的学科包（运行数据） ===
packs/*.json

# === 依赖与打包产物 ===
node_modules/
dist/
*.tgz

# === 证书与私钥（含 CA 公钥，一并排除，避免误传） ===
*.pfx
*.p12
*.key
*.pem
ca.crt
cert.pfx
cert/
certs/

# === 备份、日志与本地快照 ===
*.bak
*.bak-*
*.log
.backup/
backups/

# === 运行产物与测试临时目录 ===
output/
data/
tests/.tmp/
.tmp/
history/

# === 安卓壳：Gradle 产物 + 由 scripts/build-shell.js 生成的离线资源 ===
# （离线资源来自 public/、src/shared/、prompts/、subjects/，都是可再生的，不进仓库）
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/app/src/main/assets/

# === 编辑器 / 系统 ===
.vscode/
.idea/
Thumbs.db
Desktop.ini
~$*
*.tmp
